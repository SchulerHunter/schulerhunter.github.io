---
import { formatDate, readingTime, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> · {readingTime(post)}
        </p>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <p>{post.data.description}</p>
      </li>
    ))
  }
</ul>
