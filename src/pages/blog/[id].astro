---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <article class="post">
    <header>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post)}
        {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
      </p>
      <h1>{title}</h1>
      {tags.length > 0 && <p class="meta tags">{tags.map((tag) => <span>#{tag}</span>)}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
